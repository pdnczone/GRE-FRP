#!/usr/bin/env bash
# grepanel — control the GRE-FRP web panel after install.
# Usage: grepanel <status|logs|restart|url|password|uninstall>
set -euo pipefail

PANEL_BIN="/usr/local/bin/gre-panel"
CFG="/etc/gre-panel/panel.json"

cmd="${1:-status}"
case "$cmd" in
  status)
    systemctl is-active gre-panel 2>/dev/null || echo "panel service: not running"
    echo "--- tunnel ---"
    systemctl is-active gre-tunnel.service 2>/dev/null || echo "gre: not running"
    systemctl is-active frps 2>/dev/null >/dev/null && echo "frps: active" || true
    systemctl is-active frpc 2>/dev/null >/dev/null && echo "frpc: active" || true
    ip tunnel show 2>/dev/null | grep -E "gre-tunnel" || echo "no gre-tunnel interface"
    ;;
  logs)
    journalctl -u gre-panel -n 50 --no-pager
    ;;
  restart)
    systemctl restart gre-panel
    systemctl is-active gre-panel
    ;;
  url)
    if [[ ! -f "$CFG" ]]; then echo "panel not installed (no $CFG)"; exit 1; fi
    port=$(grep -o '"port": [0-9]*' "$CFG" | grep -o '[0-9]*')
    base=$(grep -o '"base_path": "[^"]*"' "$CFG" | cut -d'"' -f4)
    ip=$(ip route get 1.1.1.1 2>/dev/null | awk '/src/ {for (i=1; i<=NF; i++) if ($i=="src") {print $(i+1); exit}}')
    echo "http://${ip:-<this-server-ip>}:${port:-7777}/${base}"
    ;;
  password)
    # reset panel password: stop, delete config, start (prints new password)
    systemctl stop gre-panel
    rm -f "$CFG"
    systemctl start gre-panel
    sleep 2
    journalctl -u gre-panel -n 5 --no-pager | grep -i "password" || echo "see: journalctl -u gre-panel"
    ;;
  uninstall)
    read -p "Remove gre-panel service + binary? (y/N): " c
    [[ "$c" =~ ^[Yy]$ ]] || { echo "aborted"; exit 0; }
    systemctl stop gre-panel 2>/dev/null || true
    systemctl disable gre-panel 2>/dev/null || true
    rm -f /etc/systemd/system/gre-panel.service "$PANEL_BIN"
    systemctl daemon-reload
    echo "gre-panel removed (config kept in /etc/gre-panel)"
    ;;
  *)
    echo "Usage: grepanel <status|logs|restart|url|password|uninstall>"
    exit 1
    ;;
esac
